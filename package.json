{
  "name": "hindiba-blog",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Hindiba — Eşref Akbaş'ın hatıra defteri ve içerik yönetimi",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "build": "node scripts/build.js",
    "admin:create": "node --env-file-if-exists=.env scripts/admin.js",
    "import": "node --env-file-if-exists=.env scripts/import-issues.js",
    "verify": "node --env-file-if-exists=.env scripts/verify-migration.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "pages:bridge": "node --env-file-if-exists=.env scripts/pages-bridge.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.1.0",
    "marked": "^17.0.0",
    "multer": "^2.0.2",
    "quill": "2.0.2",
    "sanitize-html": "^2.17.0",
    "sharp": "0.35.5",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
