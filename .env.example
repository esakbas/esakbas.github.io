# Node.js 24 LTS. Copy to .env; this file contains no credentials.
PORT=3000
SITE_URL=http://localhost:3000
DATA_DIR=./data
NODE_ENV=development
# Set true only behind a trusted reverse proxy, with direct access blocked.
TRUST_PROXY=false
# Production: NODE_ENV=production, SITE_URL=https://your-domain.example
# Admin accounts are created through npm run admin:create; no default password.
